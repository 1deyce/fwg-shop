# Copy to client/.env for local `netlify dev`, and set the same vars in the
# Netlify dashboard (Site config -> Environment variables) for production.
# None of these are exposed to the browser (no VITE_ prefix) — they are only
# read by the serverless functions.

# --- PayFast ---
# From your PayFast dashboard. Use sandbox credentials while testing.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# "true" = sandbox (default), "false" = live
PAYFAST_SANDBOX=true

# --- Email delivery (Resend, called server-side) ---
# Sign up at https://resend.com, create an API key, and verify a sending
# domain. EMAIL_FROM must use that domain, e.g. "Shop FWG <orders@yourdomain.com>".
# For quick testing you can send from "onboarding@resend.dev" (only delivers to
# your own Resend account email).
RESEND_API_KEY=
EMAIL_FROM=
# Merchant address. In sandbox (PAYFAST_SANDBOX != "false") all order emails go
# here instead of the customer; in live mode it's BCC'd on every order. Set this
# to your Resend account email so testing works with onboarding@resend.dev.
ORDER_NOTIFY_EMAIL=

# --- Digital products ---
# The PDFs are NOT stored here. Upload each to the "products" Netlify Blobs
# store under the key set in netlify/functions/_lib/catalog.js, e.g.:
#   netlify blobs:set products 30-day-ab-challenge.pdf -i ./30-day-ab-challenge.pdf

# --- Optional ---
# Netlify sets URL automatically in deploys; only needed for some local setups.
# SITE_URL=http://localhost:8888
